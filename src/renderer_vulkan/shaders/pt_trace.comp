#version 460
// SPDX-License-Identifier: GPL-2.0-or-later
// Path tracing mode, pass 1: per pixel a primary ray through the jittered pixel, direct light
// from the map's light entities by resampled importance sampling over the pixel's light cell
// (one shadow ray), dynamic lights with shadow rays, and one cosine-sampled bounce whose hit
// returns the baked lightmap radiance (a radiance cache). Writes demodulated irradiance,
// albedo + emissive and normal + linear depth. slots: x irradiance, y albedo, z normal-depth,
// w raster depth sampler.
#extension GL_EXT_ray_query : require
#include "post_common.glsl"
#include "rt_common.glsl"
#include "rt_lighting.glsl"
#include "pt_common.glsl"
#include "ddgi_common.glsl"
#include "ddgi_sample.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

float luma(vec3 c) { return dot(c, LUMA); }

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    PtParams p = PtParams(pc.buffer1);
    if (any(greaterThanEqual(id, pc.size.xy))) return;
    vec2 pixel = vec2(id) + 0.5;
    vec2 uv = (pixel - p.rect.xy) / p.rect.zw;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        imageStore(images[pc.slots.x], ivec2(id), vec4(0.0));
        return;
    }
    // The raster's projection was jittered by +jitter in NDC.
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) - p.jitter.xy;
    vec3 dir = normalize(p.forward.xyz - p.left.xyz * ndc.x * p.forward.w + p.up.xyz * ndc.y * p.left.w);
    float rasterDepth = ptLinearDepth(texelFetch(textures[nonuniformEXT(pc.slots.w)], ivec2(id), 0).r, p.jitter.z, p.jitter.w);
    RtHit primary = rtTrace(p.table, p.origin.xyz, dir, 65536.0, 0.0);
    float eye = primary.t * dot(dir, p.forward.xyz);
    bool valid = primary.hit && primary.front && abs(eye - rasterDepth) < max(2.0, eye * 0.01);
    if (!valid) {
        imageStore(images[pc.slots.x], ivec2(id), vec4(0.0));
        imageStore(images[pc.slots.z], ivec2(id), vec4(0.0, 0.0, 0.0, -1.0));
        return;
    }
    vec3 pos = p.origin.xyz + dir * primary.t;
    vec3 n = primary.normal;
    vec3 offset = pos + n * 0.5;
    uint seed = ptHash(id.x * 1973u + id.y * 9277u + uint(p.origin.w) * 26699u);

    // Map lights: RIS over the cell's list (rtLightRaw, the radiosity's light models), one shadow ray.
    vec3 direct = vec3(0.0);
    RtFloats lights = RtFloats(p.lights);
    if (p.cellDims.w > 0u) {
        ivec3 cell = clamp(ivec3(floor((pos - p.cells.xyz) / p.cells.w)), ivec3(0), ivec3(p.cellDims.xyz) - 1);
        uint base = uint((cell.z * int(p.cellDims.y) + cell.y) * int(p.cellDims.x) + cell.x) * RT_CELL_STRIDE;
        RtWords list = RtWords(p.lightCells);
        uint count = list.v[base];
        if (count > 0u) {
            const uint M = 4u;
            float weightSum = 0.0;
            uint chosen = 0u;
            float chosenTarget = 0.0;
            vec3 chosenRaw = vec3(0.0);
            for (uint k = 0u; k < M; ++k) {
                uint pick = min(uint(ptRandom(seed) * float(count)), count - 1u);
                uint index = list.v[base + 1u + pick];
                vec3 raw = rtVisibility(list, p.cellDims.xyz, base + 1u + pick) == 0u ? vec3(0.0) : rtLightRaw(lights, index, pos, n);
                float target = luma(raw);
                float w = target * float(count);
                weightSum += w;
                if (w > 0.0 && ptRandom(seed) * weightSum < w) {
                    chosen = index;
                    chosenTarget = target;
                    chosenRaw = raw;
                }
            }
            if (chosenTarget > 0.0) {
                vec3 origin = rtLightPoint(lights, chosen, vec2(ptRandom(seed), ptRandom(seed)), offset);
                vec3 d = origin - offset;
                float dist = length(d);
                if (!rtOccluded(p.table, offset, d / dist, dist - 4.0)) {
                    // Radiosity bytes saturate at 255, as qrad's lightmaps do.
                    vec3 raw = min(chosenRaw * (weightSum / (float(M) * chosenTarget)) / 255.0 * p.up.w, vec3(1.0));
                    direct = pow(raw * p.sky.w, vec3(2.2));
                }
            }
        }
    }
    // Dynamic lights (muzzle flashes, projectiles) with shadow rays.
    RtFloats dyn = RtFloats(p.dynamicLights);
    for (uint k = 0u; k < min(p.counts.x, 16u); ++k) {
        vec3 origin = vec3(dyn.v[k * 8u], dyn.v[k * 8u + 1u], dyn.v[k * 8u + 2u]);
        float range = dyn.v[k * 8u + 3u];
        vec3 color = vec3(dyn.v[k * 8u + 4u], dyn.v[k * 8u + 5u], dyn.v[k * 8u + 6u]);
        vec3 d = origin - pos;
        float dist2 = dot(d, d);
        if (dist2 >= range * range) continue;
        float dist = sqrt(dist2);
        vec3 l = d / max(dist, 1e-3);
        float cosine = dot(n, l);
        if (cosine <= 0.0 || rtOccluded(p.table, offset, l, dist - 6.0)) continue;
        float window = clamp(1.0 - (dist2 * dist2) / (range * range * range * range), 0.0, 1.0);
        direct += rtToLinear(color) * window * window * (range * range * 0.35) / (dist2 + range * 2.0) * cosine;
    }
    // One bounce, cosine weighted: the hit's baked radiance stands in for the rest of the path.
    float r1 = ptRandom(seed), r2 = ptRandom(seed);
    vec3 helper = abs(n.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tx = normalize(cross(helper, n)), ty = cross(n, tx);
    float radius = sqrt(r1), phi = 6.2831853 * r2;
    vec3 bounceDir = normalize(tx * radius * cos(phi) + ty * radius * sin(phi) + n * sqrt(max(1.0 - r1, 0.0)));
    RtHit bounce = rtTrace(p.table, offset, bounceDir, 8192.0, 3.0);
    vec3 indirect = bounce.hit ? (bounce.front ? bounce.radiance : vec3(0.0)) : p.sky.rgb;
    if (p.rtSky.w > 0.5) {
        // No lightmaps: the bounce hit is lit by the map lights (one traced shadow, the strongest
        // light), by the probe field (the further bounces) and glows if emissive; escaping rays
        // see the sky.
        indirect = p.rtSky.rgb;
        if (bounce.hit) {
            indirect = vec3(0.0);
            if (bounce.front) {
                vec3 hitPos = offset + bounceDir * bounce.t;
                vec3 hitDirect = vec3(0.0);
                if (p.cellDims.w > 0u)
                    hitDirect = rtRawToLinear(rtMapLightRaw(p.table, p.lights, p.lightCells, p.cells, p.cellDims.xyz,
                        hitPos, bounce.normal, hitPos + bounce.normal * 1.0, 1u), p.up.w, p.sky.w);
                vec4 field = ddgiSample(p.ddgiSlots, p.ddgiSlots2, p.ddgiOrigin, p.ddgiDims, hitPos + bounce.normal * 4.0, bounce.normal);
                indirect = bounce.albedo * (hitDirect + field.rgb / 3.14159265 * field.a + bounce.emissive);
            }
        }
    }
    vec3 irradiance = direct + indirect;
    imageStore(images[pc.slots.x], ivec2(id), vec4(irradiance, 1.0));
    imageStore(images[pc.slots.y], ivec2(id), vec4(primary.albedo, primary.emissive / 8.0));
    imageStore(images[pc.slots.z], ivec2(id), vec4(n, eye));
}
