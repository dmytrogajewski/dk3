[Unit]
Description=dk3 HTTPS proxy with explicit test CA
After=network-online.target dk3-coordinator.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/dk3/proxy.env
ExecStart=/usr/bin/caddy run --config /etc/dk3/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/dk3/Caddyfile --adapter caddyfile
TimeoutStopSec=5s
LimitNOFILE=16384
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
MemoryMax=256M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
